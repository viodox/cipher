{
  "rewrites": [
    { "source": "/ai-decrypt", "destination": "/api/page?route=ai-decrypt" },
    { "source": "/profile", "destination": "/api/page?route=profile" },
    { "source": "/cipherpot", "destination": "/api/page?route=cipherpot" },
    { "source": "/on-chain-stocks", "destination": "/api/page?route=on-chain-stocks" },
    { "source": "/rug-radar", "destination": "/api/page?route=rug-radar" },
    { "source": "/scan/:chain/:address", "destination": "/api/scan?chain=:chain&address=:address" },
    { "source": "/og/scan/:chain/:address.png", "destination": "/api/og?chain=:chain&address=:address" },
    { "source": "/movers", "destination": "/api/content?page=movers" },
    { "source": "/updates", "destination": "/api/content?page=updates" },
    { "source": "/alerts", "destination": "/api/content?page=alerts" },
    { "source": "/coin/:id", "destination": "/api/coin?id=:id" },
    { "source": "/og/movers.png", "destination": "/api/og?kind=movers" },
    { "source": "/og/coin/:id.png", "destination": "/api/og?kind=coin&id=:id" },
    { "source": "/sitemap-coins.xml", "destination": "/api/sitemap-coins" }
  ],
  "functions": {
    "api/page.js": { "includeFiles": "index.html", "maxDuration": 10 },
    "api/og.js": { "includeFiles": "fonts/**", "maxDuration": 10 },
    "api/scan.js": { "maxDuration": 10 },
    "api/security.js": { "maxDuration": 10 },
    "api/radar.js": { "maxDuration": 10 },
    "api/content.js": { "includeFiles": "data/updates.json", "maxDuration": 10 },
    "api/updates.js": { "includeFiles": "data/updates.json", "maxDuration": 10 },
    "api/coin.js": { "maxDuration": 10 },
    "api/movers.js": { "maxDuration": 10 },
    "api/alerts.js": { "maxDuration": 10 },
    "api/sitemap-coins.js": { "maxDuration": 10 }
  }
}
