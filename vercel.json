{
  "rewrites": [
    { "source": "/rq/s/:path*", "destination": "https://www.ciphersignal.xyz/_vercel/insights/:path*" },
    { "source": "/", "destination": "/api/site?page=home" },
    { "source": "/index.html", "destination": "/api/site?page=home" },
    { "source": "/smart-money", "destination": "/api/site?page=smart-money" },
    { "source": "/compare", "destination": "/api/site?page=compare" },
    { "source": "/digest", "destination": "/api/site?page=digest" },
    { "source": "/api/boot", "destination": "/api/site?page=boot" },
    { "source": "/api/board", "destination": "/api/site?page=board" },
    { "source": "/api/smart-money", "destination": "/api/site?page=smart-money-json" },
    { "source": "/api/digest", "destination": "/api/alerts?action=digest" },
    { "source": "/og/smart-money.png", "destination": "/api/scan?mode=og&kind=smart-money" },
    { "source": "/api/ape-view", "destination": "/api/site?page=ape-view" },
    { "source": "/ai-decrypt", "destination": "/api/site?page=ai-decrypt" },
    { "source": "/profile", "destination": "/api/site?page=profile" },
    { "source": "/cipherpot", "destination": "/api/site?page=cipherpot" },
    { "source": "/on-chain-stocks", "destination": "/api/site?page=on-chain-stocks" },
    { "source": "/rug-radar", "destination": "/api/site?page=rug-radar" },
    { "source": "/movers", "destination": "/api/site?page=movers" },
    { "source": "/updates", "destination": "/api/site?page=updates" },
    { "source": "/alerts", "destination": "/api/site?page=alerts" },
    { "source": "/check", "destination": "/api/site?page=check" },
    { "source": "/hall", "destination": "/api/site?page=hall" },
    { "source": "/shame", "destination": "/api/site?page=shame" },
    { "source": "/check/:chain/:address", "destination": "/api/site?page=ape&chain=:chain&address=:address" },
    { "source": "/coin/:id", "destination": "/api/site?page=coin&id=:id" },
    { "source": "/sitemap-coins.xml", "destination": "/api/site?page=sitemap" },
    { "source": "/api/updates", "destination": "/api/site?page=updates-json" },
    { "source": "/api/movers", "destination": "/api/site?page=movers-json" },
    { "source": "/api/canon", "destination": "/api/site?page=canon" },
    { "source": "/scan/:chain/:address", "destination": "/api/scan?chain=:chain&address=:address" },
    { "source": "/api/check", "destination": "/api/scan?mode=check" },
    { "source": "/api/check/:chain/:address", "destination": "/api/scan?mode=check&chain=:chain&address=:address" },
    { "source": "/api/security", "destination": "/api/scan?mode=security" },
    { "source": "/api/radar", "destination": "/api/scan?mode=radar" },
    { "source": "/api/og", "destination": "/api/scan?mode=og" },
    { "source": "/og/scan/:chain/:address.png", "destination": "/api/scan?mode=og&chain=:chain&address=:address" },
    { "source": "/og/movers.png", "destination": "/api/scan?mode=og&kind=movers" },
    { "source": "/og/coin/:id.png", "destination": "/api/scan?mode=og&kind=coin&id=:id" },
    { "source": "/og/check/:chain/:address.png", "destination": "/api/scan?mode=og&kind=ape&chain=:chain&address=:address" },
    { "source": "/api/alerts/run", "destination": "/api/alerts?action=run" },
    { "source": "/api/alerts/unsubscribe", "destination": "/api/alerts?action=unsubscribe" },
    { "source": "/api/coingecko/:path+", "destination": "/api/coingecko" }
  ],
  "crons": [
    { "path": "/api/alerts?action=run", "schedule": "0 13 * * *" }
  ],
  "functions": {
    "api/coingecko.js": { "maxDuration": 10 },
    "api/alerts.js": { "maxDuration": 10 },
    "api/site.js": { "includeFiles": "templates/home.html", "maxDuration": 10 },
    "api/scan.js": { "includeFiles": "fonts/**", "maxDuration": 10 }
  }
}
